[Desktop Entry]
Name=WemeetApp
Name[zh_CN]=腾讯会议
Comment=Tencent Meeting (user override: preload v4l2 fix, otherwise camera is black)
Exec=env LD_PRELOAD=/home/arch/virtualcamera/wemeet-v4l2fix.so /opt/wemeet/wemeetapp.sh %u
Icon=/opt/wemeet/wemeet.svg
Type=Application
Terminal=false
Categories=AudioVideo;
MimeType=x-scheme-handler/wemeet;
